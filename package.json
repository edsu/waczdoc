{
  "name": "wacz-pdf",
  "version": "1.1.0",
  "description": "Render the HTML pages in a WACZ web archive to PDF, one per page, via wabac.js replay in headless Chromium -- or extract them as Markdown",
  "main": "dist/cli.js",
  "scripts": {
    "test": "tsc && node --test",
    "test:unit": "tsc && node --test test/range.test.js test/util.test.js test/zipread.test.js test/wacz.test.js test/markdown.test.js",
    "build": "tsc",
    "prepublishOnly": "tsc",
    "lint": "eslint ."
  },
  "keywords": [
    "wacz",
    "warc",
    "web-archive",
    "webrecorder",
    "wabac",
    "pdf",
    "playwright",
    "archiving",
    "replay",
    "cdx",
    "markdown",
    "defuddle"
  ],
  "author": "ehs@pobox.com",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@webrecorder/wabac": "^2.26.6",
    "defuddle": "0.19.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.62.1"
  },
  "bin": {
    "wacz-pdf": "dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edsu/wacz-pdf.git"
  },
  "homepage": "https://github.com/edsu/wacz-pdf#readme",
  "bugs": {
    "url": "https://github.com/edsu/wacz-pdf/issues"
  }
}
